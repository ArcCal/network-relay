#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
async fn measured_h2_bulk_and_sibling_latency() {
    let relay = TestRelay::start("").await;
    let (echo, _server) = echo_server().await;
    let opts = relay.options(ALICE, echo, echo);
    let (sender, _driver) = check::h2_sender(&opts, &opts.addresses).await.unwrap();
    for (label, workers, size, slow) in [
        ("small", 4, 4096, false),
        ("single", 1, 32 << 20, false),
        ("shared", 4, 8 << 20, false),
        ("slow-sibling", 4, 8 << 20, true),
    ] {
        let expected = Arc::new(pattern(size));
        let opening = Arc::new(tokio::sync::Barrier::new(workers));
        let mut group = tokio::task::JoinSet::new();
        let wall=std::time::Instant::now();
        for i in 0..workers {
            let mut sender=sender.clone();
            let expected=expected.clone();let opening=opening.clone();
            group.spawn(async move {
                sender.ready().await.unwrap();
                let req = Request::builder().method(Method::CONNECT).uri(echo.to_string())
                    .header("authorization", auth::basic_authorization(ALICE.0, ALICE.1))
                    .body(Empty::<Bytes>::new()).unwrap();
                let mut response=sender.send_request(req).await.unwrap();
                assert_eq!(response.status(),StatusCode::OK);
                let io=TokioIo::new(hyper::upgrade::on(&mut response).await.unwrap());
                let (mut rd, mut wr)=tokio::io::split(io);
                opening.wait().await;
                let start=std::time::Instant::now();
                let data=expected.clone();
                let writer=tokio::spawn(async move {wr.write_all(&data).await.unwrap();wr.shutdown().await.unwrap();});
                let mut buf=vec![0;64*1024];
                let mut total=0;
                let mut slow_mark=0;
                loop {
                    let n=rd.read(&mut buf).await.unwrap(); if n==0 {break;}
                    assert_eq!(&buf[..n],&expected[total..total+n]);
                    total+=n;
                    if slow && i==0 && total/65536>slow_mark {
                        slow_mark=total/65536;
                        tokio::time::sleep(Duration::from_millis(2)).await;
                    }
                }
                writer.await.unwrap();
                assert_eq!(total,expected.len());
                (i,start.elapsed().as_micros())
            });
        }
        let mut times=Vec::new();
        while let Some(result)=tokio::time::timeout(Duration::from_secs(45),group.join_next()).await.unwrap() {
            times.push(result.unwrap());
        }
        times.sort_unstable();
        eprintln!("H2-BULK {label} bytes={size} streams={workers} wall_us={} flows={times:?}",wall.elapsed().as_micros());
    }
}
