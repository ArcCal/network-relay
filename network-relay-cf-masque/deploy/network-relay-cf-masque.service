[Unit]
Description=Experimental Network Relay with mandatory WARP MASQUE egress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=network-relay-cf-masque
Group=network-relay-cf-masque
WorkingDirectory=/opt/network-relay-cf-masque
ExecStart=/opt/network-relay-cf-masque/target/release/network-relay-cf-masque serve --config /opt/network-relay-cf-masque/config/relay.toml --warp-config /opt/network-relay-cf-masque/config/warp.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/network-relay-cf-masque
# Permit binding 443 without running as root; no TUN or NET_ADMIN needed.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
