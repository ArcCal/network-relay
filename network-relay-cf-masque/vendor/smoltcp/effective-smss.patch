+    fn mss_test_flight(s: &mut TestSocket, millis: i64) -> Vec<usize> {
+        s.cx.set_now(Instant::from_millis(millis));
+        let mut payloads = Vec::new();
+        for _ in 0..128 {
+            let mut emitted = false;
+            s.socket
+                .dispatch(&mut s.cx, |_, _, (_, repr)| {
+                    emitted = true;
+                    if !repr.payload.is_empty() {
+                        payloads.push(repr.payload.len());
+                    }
+                    Ok::<_, ()>(())
+                })
+                .unwrap();
+            if !emitted {
+                return payloads;
+            }
+        }
+        panic!("a flight must be bounded");
+    }
