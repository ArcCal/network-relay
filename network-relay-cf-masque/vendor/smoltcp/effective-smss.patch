+// Compare observable bytes rather than the internal structured/raw ICMP
+// representation. Original-header preservation intentionally uses raw payloads.
+fn assert_packet_wire_eq(actual: Option<Packet<'_>>, expected: Option<Packet<'_>>) {
+    fn wire(packet: Packet<'_>) -> Vec<u8> {
+        let repr = packet.ip_repr();
+        let header = repr.buffer_len();
+        let mut bytes = vec![0; header + repr.payload_len()];
+        let caps = crate::phy::DeviceCapabilities::default();
+        repr.emit(&mut bytes[..header], &caps.checksum);
+        packet.emit_payload(&repr, &mut bytes[header..], &caps);
+        bytes
+    }
+    assert_eq!(actual.map(wire), expected.map(wire));
+}
