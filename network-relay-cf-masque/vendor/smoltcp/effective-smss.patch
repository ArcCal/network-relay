+            let Some(tx) = device.transmit(self.inner.now) else { return; };
+            let Some(raw) = self.fragments.ipv4.assembler.take_expired(self.inner.now) else { return; };
+            let Ok(p) = Ipv4Packet::new_checked(raw) else { continue; };
